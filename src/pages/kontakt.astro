---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const phone = "+41 44 499 05 03";
const phoneHref = "tel:+41444990503";
const email = "kontakt@umzugsreinigungprofis.ch";
---

<Layout
  title="Kontakt | Umzugsreinigungprofis – Deutschschweiz"
  description="Kontaktieren Sie Umzugsreinigungprofis für Ihre Umzugsreinigung in der Deutschschweiz. Telefon, E-Mail, Adresse und Öffnungszeiten."
>
  <Header />
  <main>
    <section class="bg-dark text-white py-16 lg:py-20">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold mb-4">Kontakt</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Wir sind für Sie da. Kontaktieren Sie Umzugsreinigungprofis – wir melden uns innert 24 Stunden bei Ihnen zurück.
        </p>
      </div>
    </section>

    <section class="py-16 lg:py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-8">

          <!-- Contact Info -->
          <div class="bg-slate-50 rounded-2xl p-8">
            <h2 class="text-2xl font-bold text-dark mb-6">Direkt erreichbar</h2>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                </div>
                <div>
                  <p class="text-sm text-slate-500 mb-1">Telefon</p>
                  <a href={phoneHref} class="text-lg font-bold text-dark hover:text-primary-600 transition-colors">{phone}</a>
                  <p class="text-xs text-slate-500 mt-1">Mo - Sa: 07:00 - 20:00 Uhr</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                  <p class="text-sm text-slate-500 mb-1">E-Mail</p>
                  <a href={`mailto:${email}`} class="text-lg font-bold text-dark hover:text-primary-600 transition-colors break-all">{email}</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                  <p class="text-sm text-slate-500 mb-1">Adresse</p>
                  <address class="text-base font-semibold text-dark not-italic">
                    Umzugsreinigungprofis<br />
                    Dufourstrasse 48<br />
                    8008 Zürich<br />
                    Schweiz
                  </address>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                  <p class="text-sm text-slate-500 mb-1">Öffnungszeiten</p>
                  <p class="text-base text-dark">Montag - Samstag<br />07:00 - 20:00 Uhr</p>
                  <p class="text-xs text-slate-500 mt-1">Sonntag geschlossen</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm">
            <h2 class="text-2xl font-bold text-dark mb-2">Gratis Offerte anfordern</h2>
            <p class="text-sm text-slate-500 mb-6">Unverbindlich & kostenlos – Antwort innert 24h</p>

            <form id="contactForm" class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="36327559-92e8-401a-8007-6fc8bafae5b9" />
              <input type="hidden" name="subject" value="Neue Kontaktanfrage – umzugsreinigungprofis.ch" />
              <input type="hidden" name="from_name" value="Umzugsreinigungprofis Webseite" />
              <input type="hidden" name="redirect" value="https://umzugsreinigungprofis.ch/?success=true" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Vor- und Nachname *</label>
                <input type="text" id="name" name="name" required placeholder="Max Muster"
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">Telefonnummer *</label>
                <input type="tel" id="phone" name="phone" required placeholder="+41 79 XXX XX XX"
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">E-Mail</label>
                <input type="email" id="email" name="email" placeholder="max@beispiel.ch"
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-slate-700 mb-1">Nachricht</label>
                <textarea id="message" name="message" rows="5" placeholder="Beschreiben Sie kurz Ihre Anfrage..."
                  class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm resize-none"></textarea>
              </div>
              <button type="submit"
                class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-6 rounded-lg transition-colors text-base">
                Nachricht senden
              </button>
              <p class="text-xs text-slate-400 text-center">Ihre Daten werden vertraulich behandelt gemäss unserer <a href="/datenschutz" class="text-primary-600 hover:underline">Datenschutzerklärung</a>.</p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar />
  <WhatsAppButton />
</Layout>
