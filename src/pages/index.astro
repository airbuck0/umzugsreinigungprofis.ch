---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBadges from '../components/TrustBadges.astro';
import WasIstUmzugsreinigung from '../components/WasIstUmzugsreinigung.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import Benefits from '../components/Benefits.astro';
import Process from '../components/Process.astro';
import Guarantee from '../components/Guarantee.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="Umzugsreinigung Schweiz | Professionelle Endreinigung mit Abnahmegarantie"
  description="Über 20 Jahre Erfahrung & ⭐ 5-Sterne-Bewertungen. Wir machen Ihre Wohnung abnahmefertig sauber – mit Garantie & Festpreis. Gratis-Offerte in 24 h!"
>
  <Header />
  <main>
    <Hero />
    <TrustBadges />
    <WasIstUmzugsreinigung />
    <Services />
    <Pricing />
    <Guarantee />
    <Benefits />
    <Process />
    <ServiceAreas />
    <Testimonials />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <MobileBar />
  <WhatsAppButton />
</Layout>
