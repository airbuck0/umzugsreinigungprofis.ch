---
const phoneHref = "tel:+41440000000";
---

<!-- Sticky Mobile Bottom Bar -->
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 shadow-lg z-50 lg:hidden">
  <div class="grid grid-cols-2 divide-x divide-slate-200">
    <a href={phoneHref} class="flex items-center justify-center gap-2 py-3.5 text-dark font-semibold text-sm hover:bg-slate-50 transition-colors">
      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
      Jetzt anrufen
    </a>
    <a href="#kontakt" class="flex items-center justify-center gap-2 py-3.5 bg-primary-600 text-white font-semibold text-sm hover:bg-primary-700 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      Offerte anfordern
    </a>
  </div>
</div>
