---
const testimonials = [
  {
    name: "Sandra M.",
    location: "Zürich",
    text: "Absolut top! Die Wohnung wurde bei der Abnahme ohne Beanstandungen akzeptiert. Das Team war pünktlich, freundlich und sehr gründlich. Kann ich nur weiterempfehlen!",
    rating: 5,
  },
  {
    name: "Marco B.",
    location: "Bern",
    text: "Wir hatten kurzfristig einen Termin gebraucht und Umzugsreinigung Profis hat es ermöglicht. Die Endreinigung war einwandfrei und die Verwaltung war zufrieden. Preis-Leistung stimmt!",
    rating: 5,
  },
  {
    name: "Lisa K.",
    location: "Basel",
    text: "Nach einem stressigen Umzug war es eine riesige Erleichterung, die Reinigung in professionelle Hände zu geben. Alles wurde perfekt gereinigt – inklusive Backofen und Fenster.",
    rating: 5,
  },
  {
    name: "Thomas W.",
    location: "Winterthur",
    text: "Sehr professionell und zuverlässig. Die Abnahme verlief reibungslos. Besonders gut: Die transparenten Festpreise ohne versteckte Kosten. Vielen Dank!",
    rating: 5,
  },
];

const stars = (count: number) => Array.from({ length: count }, () => null);
---

<section id="bewertungen" class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl lg:text-3xl font-bold text-dark mb-4">
        Das sagen unsere <span class="text-primary-600">Kunden</span>
      </h2>
      <div class="flex items-center justify-center gap-2 mb-2">
        <div class="flex gap-0.5">
          {stars(5).map(() => (
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
          ))}
        </div>
        <span class="text-lg font-bold text-dark">4.9 / 5</span>
        <span class="text-slate-500 text-sm">basierend auf 200+ Bewertungen</span>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {testimonials.map(t => (
        <div class="bg-slate-50 rounded-xl p-6">
          <div class="flex gap-0.5 mb-3">
            {stars(t.rating).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
            ))}
          </div>
          <p class="text-sm text-slate-600 leading-relaxed mb-4 italic">"{t.text}"</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center">
              <span class="text-xs font-bold text-primary-700">{t.name.charAt(0)}</span>
            </div>
            <div>
              <div class="text-sm font-semibold text-dark">{t.name}</div>
              <div class="text-xs text-slate-500">{t.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
