---
const phone = "+41 44 499 05 03";
const phoneHref = "tel:+41444990503";
---

<!-- Top Bar -->
<div class="bg-dark text-white text-sm py-2">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <a href={phoneHref} class="flex items-center gap-1 hover:text-primary-300 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        {phone}
      </a>
      <a href="mailto:kontakt@umzugsreinigungprofis.ch" class="hidden sm:flex items-center gap-1 hover:text-primary-300 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        kontakt@umzugsreinigungprofis.ch
      </a>
    </div>
    <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400">
      <span>Mo-Sa: 07:00 - 20:00</span>
    </div>
  </div>
</div>

<!-- Main Nav -->
<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 flex-shrink-0">
        <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"></path></svg>
        </div>
        <div>
          <span class="text-lg lg:text-xl font-bold text-dark leading-tight block">Umzugsreinigung</span>
          <span class="text-xs lg:text-sm font-semibold text-primary-600 -mt-1 block">PROFIS</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6">
        <a href="#leistungen" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Leistungen</a>
        <a href="#preise" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Preise</a>
        <a href="#ablauf" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Ablauf</a>
        <a href="#gebiete" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Gebiete</a>
        <a href="#bewertungen" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Bewertungen</a>
        <a href="#faq" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">FAQ</a>
        <a href="#kontakt" class="text-sm font-medium text-slate-700 hover:text-primary-600 transition-colors">Kontakt</a>
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href={phoneHref} class="flex items-center gap-2 text-dark font-bold text-lg hover:text-primary-600 transition-colors">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          {phone}
        </a>
        <a href="#kontakt" class="bg-primary-600 hover:bg-primary-700 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm">
          Offerte anfordern
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-700" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t">
    <div class="px-4 py-3 space-y-1">
      <a href="#leistungen" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Leistungen</a>
      <a href="#preise" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Preise</a>
      <a href="#ablauf" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Ablauf</a>
      <a href="#gebiete" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Gebiete</a>
      <a href="#bewertungen" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Bewertungen</a>
      <a href="#faq" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">FAQ</a>
      <a href="#kontakt" class="block py-2 text-slate-700 hover:text-primary-600 font-medium">Kontakt</a>
      <a href={phoneHref} class="block py-2 text-primary-600 font-bold">{phone}</a>
    </div>
  </div>
</header>
