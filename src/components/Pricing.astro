---
const apartmentPrices = [
  { rooms: "1.5 Zimmer", price: "CHF 349" },
  { rooms: "2 Zimmer", price: "CHF 399" },
  { rooms: "2.5 Zimmer", price: "CHF 449" },
  { rooms: "3 Zimmer", price: "CHF 549" },
  { rooms: "3.5 Zimmer", price: "CHF 599" },
  { rooms: "4 Zimmer", price: "CHF 699" },
  { rooms: "4.5 Zimmer", price: "CHF 749" },
  { rooms: "5 Zimmer", price: "CHF 849" },
  { rooms: "5.5 Zimmer", price: "CHF 899" },
  { rooms: "6+ Zimmer", price: "CHF 999" },
];

const housePrices = [
  { rooms: "4.5 Zimmer", price: "CHF 999" },
  { rooms: "5.5 Zimmer", price: "CHF 1'199" },
  { rooms: "6.5 Zimmer", price: "CHF 1'399" },
  { rooms: "7.5 Zimmer", price: "CHF 1'599" },
  { rooms: "8.5+ Zimmer", price: "CHF 1'899" },
];

const includes = [
  "100% Abnahmegarantie",
  "Anfahrt inklusive",
  "Reinigungsmaterial inklusive",
  "MwSt. (8.1%) inklusive",
];
---

<section id="preise" class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-2xl lg:text-3xl font-bold text-dark mb-4">
        Unsere Preise für die <span class="text-primary-600">Umzugsreinigung</span>
      </h2>
      <p class="text-slate-600 max-w-2xl mx-auto">
        Transparente Festpreise ohne versteckte Kosten. Alle Preise verstehen sich inklusive Material, Anfahrt und MwSt.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Apartments -->
      <div class="bg-white border-2 border-primary-100 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-primary-600 text-white p-6 text-center">
          <div class="flex items-center justify-center gap-2 mb-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <h3 class="text-xl font-bold">Wohnung</h3>
          </div>
          <p class="text-primary-100 text-sm">Endreinigung für Mietwohnungen</p>
        </div>
        <div class="p-6">
          <div class="space-y-3">
            {apartmentPrices.map((item, i) => (
              <div class={`flex justify-between items-center py-2 px-3 rounded-lg ${i % 2 === 0 ? 'bg-slate-50' : ''}`}>
                <span class="text-slate-700 font-medium">{item.rooms}</span>
                <span class="text-dark font-bold text-lg">{item.price}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <div class="space-y-2">
              {includes.map(item => (
                <div class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  {item}
                </div>
              ))}
            </div>
          </div>
          <a href="#kontakt" class="mt-6 block text-center bg-primary-600 hover:bg-primary-700 text-white font-semibold py-3 rounded-lg transition-colors">
            Offerte anfordern
          </a>
        </div>
      </div>

      <!-- Houses -->
      <div class="bg-white border-2 border-primary-100 rounded-2xl overflow-hidden shadow-lg">
        <div class="bg-dark text-white p-6 text-center">
          <div class="flex items-center justify-center gap-2 mb-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"></path></svg>
            <h3 class="text-xl font-bold">Haus</h3>
          </div>
          <p class="text-slate-300 text-sm">Endreinigung für Einfamilienhäuser</p>
        </div>
        <div class="p-6">
          <div class="space-y-3">
            {housePrices.map((item, i) => (
              <div class={`flex justify-between items-center py-2 px-3 rounded-lg ${i % 2 === 0 ? 'bg-slate-50' : ''}`}>
                <span class="text-slate-700 font-medium">{item.rooms}</span>
                <span class="text-dark font-bold text-lg">{item.price}</span>
              </div>
            ))}
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <div class="space-y-2">
              {includes.map(item => (
                <div class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="w-4 h-4 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                  {item}
                </div>
              ))}
            </div>
          </div>
          <a href="#kontakt" class="mt-6 block text-center bg-dark hover:bg-slate-800 text-white font-semibold py-3 rounded-lg transition-colors">
            Offerte anfordern
          </a>
        </div>
      </div>
    </div>

    <p class="text-center text-sm text-slate-500 mt-8">
      * Preise können je nach Zustand der Wohnung variieren. Die genauen Kosten erfahren Sie in der persönlichen Offerte.
    </p>
  </div>
</section>
