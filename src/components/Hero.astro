---
const phone = "+41 44 XXX XX XX";
const phoneHref = "tel:+41440000000";
---

<section class="relative bg-dark overflow-hidden">
  <!-- Background gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-dark via-slate-900 to-primary-900 opacity-95"></div>
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>

  <div class="relative max-w-7xl mx-auto px-4 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Content -->
      <div>
        <div class="inline-flex items-center gap-2 bg-primary-600/20 border border-primary-500/30 text-primary-300 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
          Schweizweit mit Abnahmegarantie
        </div>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-6">
          Professionelle <span class="text-primary-400">Umzugsreinigung</span> in der ganzen Schweiz
        </h1>

        <p class="text-lg text-slate-300 mb-8 max-w-xl">
          Ihre Endreinigung in besten Händen. Wir übernehmen die komplette Wohnungsreinigung nach Ihrem Umzug – mit <strong class="text-white">100% Abnahmegarantie</strong> durch die Verwaltung.
        </p>

        <!-- USPs -->
        <div class="grid sm:grid-cols-2 gap-3 mb-8">
          <div class="flex items-center gap-3 text-white">
            <div class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <span class="text-sm font-medium">100% Abnahmegarantie</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <div class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <span class="text-sm font-medium">Faire Festpreise</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <div class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <span class="text-sm font-medium">Professionelles Team</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <div class="w-8 h-8 bg-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            </div>
            <span class="text-sm font-medium">Gratis Offerte</span>
          </div>
        </div>

        <!-- Phone CTA -->
        <a href={phoneHref} class="inline-flex items-center gap-3 bg-accent hover:bg-emerald-600 text-white font-bold px-6 py-3.5 rounded-xl transition-colors text-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Jetzt anrufen: {phone}
        </a>
      </div>

      <!-- Right: Contact Form -->
      <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8" id="kontakt-hero">
        <div class="text-center mb-6">
          <h2 class="text-xl font-bold text-dark">Gratis Offerte anfordern</h2>
          <p class="text-sm text-slate-500 mt-1">Unverbindlich & kostenlos</p>
        </div>
        <form class="space-y-4" action="#" method="POST">
          <div>
            <label for="hero-name" class="block text-sm font-medium text-slate-700 mb-1">Vor- und Nachname *</label>
            <input type="text" id="hero-name" name="name" required placeholder="Max Muster"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
          </div>
          <div>
            <label for="hero-phone" class="block text-sm font-medium text-slate-700 mb-1">Telefonnummer *</label>
            <input type="tel" id="hero-phone" name="phone" required placeholder="+41 79 XXX XX XX"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
          </div>
          <div>
            <label for="hero-email" class="block text-sm font-medium text-slate-700 mb-1">E-Mail</label>
            <input type="email" id="hero-email" name="email" placeholder="max@beispiel.ch"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
          </div>
          <div>
            <label for="hero-rooms" class="block text-sm font-medium text-slate-700 mb-1">Anzahl Zimmer</label>
            <select id="hero-rooms" name="rooms"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm bg-white">
              <option value="">Bitte wählen</option>
              <option value="1.5">1.5 Zimmer</option>
              <option value="2.5">2.5 Zimmer</option>
              <option value="3.5">3.5 Zimmer</option>
              <option value="4.5">4.5 Zimmer</option>
              <option value="5.5">5.5 Zimmer</option>
              <option value="6.5+">6.5+ Zimmer</option>
            </select>
          </div>
          <div>
            <label for="hero-message" class="block text-sm font-medium text-slate-700 mb-1">Nachricht</label>
            <textarea id="hero-message" name="message" rows="3" placeholder="Weitere Details zu Ihrer Umzugsreinigung..."
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-6 rounded-lg transition-colors text-base">
            Jetzt Gratis-Offerte anfordern
          </button>
          <p class="text-xs text-slate-400 text-center">Ihre Daten werden vertraulich behandelt.</p>
        </form>
      </div>
    </div>
  </div>

  <!-- Diagonal clip -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-white" style="clip-path: polygon(0 100%, 100% 100%, 100% 0);"></div>
</section>
