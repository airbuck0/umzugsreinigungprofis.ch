---
const phone = "+41 44 499 05 03";
const phoneHref = "tel:+41444990503";
---

<section id="kontakt" class="relative py-16 lg:py-24 bg-dark overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-dark via-slate-900 to-primary-900 opacity-95"></div>
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>

  <div class="relative max-w-7xl mx-auto px-4">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: CTA Text -->
      <div>
        <h2 class="text-2xl lg:text-4xl font-extrabold text-white mb-6">
          Bereit für Ihre <span class="text-primary-400">Umzugsreinigung</span>?
        </h2>
        <p class="text-lg text-slate-300 mb-8">
          Fordern Sie jetzt Ihre kostenlose und unverbindliche Offerte an – oder rufen Sie uns direkt an. Wir beraten Sie gerne und erstellen Ihnen ein massgeschneidertes Angebot.
        </p>

        <div class="space-y-4 mb-8">
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            <span>Kostenlose & unverbindliche Offerte</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            <span>Antwort innerhalb von 24 Stunden</span>
          </div>
          <div class="flex items-center gap-3 text-white">
            <svg class="w-5 h-5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            <span>100% Abnahmegarantie</span>
          </div>
        </div>

        <a href={phoneHref} class="inline-flex items-center gap-3 bg-accent hover:bg-emerald-600 text-white font-bold px-6 py-4 rounded-xl transition-colors text-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Jetzt anrufen: {phone}
        </a>
      </div>

      <!-- Right: Contact Form -->
      <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8">
        <div class="text-center mb-6">
          <h3 class="text-xl font-bold text-dark">Gratis Offerte anfordern</h3>
          <p class="text-sm text-slate-500 mt-1">Füllen Sie das Formular aus – wir melden uns innert 24h</p>
        </div>
        <form class="space-y-4" action="#" method="POST">
          <div>
            <label for="cta-name" class="block text-sm font-medium text-slate-700 mb-1">Vor- und Nachname *</label>
            <input type="text" id="cta-name" name="name" required placeholder="Max Muster"
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="cta-phone" class="block text-sm font-medium text-slate-700 mb-1">Telefonnummer *</label>
              <input type="tel" id="cta-phone" name="phone" required placeholder="+41 79 XXX XX XX"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
            </div>
            <div>
              <label for="cta-email" class="block text-sm font-medium text-slate-700 mb-1">E-Mail</label>
              <input type="email" id="cta-email" name="email" placeholder="max@beispiel.ch"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
            </div>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="cta-rooms" class="block text-sm font-medium text-slate-700 mb-1">Anzahl Zimmer</label>
              <select id="cta-rooms" name="rooms"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm bg-white">
                <option value="">Bitte wählen</option>
                <option value="1.5">1.5 Zimmer</option>
                <option value="2.5">2.5 Zimmer</option>
                <option value="3.5">3.5 Zimmer</option>
                <option value="4.5">4.5 Zimmer</option>
                <option value="5.5">5.5 Zimmer</option>
                <option value="6.5+">6.5+ Zimmer</option>
              </select>
            </div>
            <div>
              <label for="cta-city" class="block text-sm font-medium text-slate-700 mb-1">Stadt / Ort</label>
              <input type="text" id="cta-city" name="city" placeholder="z.B. Zürich"
                class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm" />
            </div>
          </div>
          <div>
            <label for="cta-message" class="block text-sm font-medium text-slate-700 mb-1">Nachricht</label>
            <textarea id="cta-message" name="message" rows="3" placeholder="Gewünschter Termin, besondere Wünsche..."
              class="w-full px-4 py-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition text-sm resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-3 px-6 rounded-lg transition-colors text-base">
            Jetzt Gratis-Offerte anfordern
          </button>
          <p class="text-xs text-slate-400 text-center">Ihre Daten werden vertraulich behandelt und nicht an Dritte weitergegeben.</p>
        </form>
      </div>
    </div>
  </div>
</section>
