---
const phone = "+41 44 XXX XX XX";
const phoneHref = "tel:+41440000000";
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-white">
  <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Company Info -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-10 h-10 bg-primary-600 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1"></path></svg>
          </div>
          <div>
            <span class="font-bold block leading-tight">Umzugsreinigung</span>
            <span class="text-xs font-semibold text-primary-400">PROFIS</span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-4">
          Ihr Partner für professionelle Umzugsreinigung und Endreinigung in der ganzen Schweiz. Mit Abnahmegarantie und fairen Festpreisen.
        </p>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-semibold text-white mb-4">Unsere Leistungen</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#leistungen" class="hover:text-primary-400 transition-colors">Umzugsreinigung</a></li>
          <li><a href="#leistungen" class="hover:text-primary-400 transition-colors">Endreinigung</a></li>
          <li><a href="#leistungen" class="hover:text-primary-400 transition-colors">Wohnungsabgabereinigung</a></li>
          <li><a href="#preise" class="hover:text-primary-400 transition-colors">Preise</a></li>
          <li><a href="#gebiete" class="hover:text-primary-400 transition-colors">Einsatzgebiete</a></li>
        </ul>
      </div>

      <!-- Standorte -->
      <div>
        <h4 class="font-semibold text-white mb-4">Standorte</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li>Umzugsreinigung Zürich</li>
          <li>Umzugsreinigung Bern</li>
          <li>Umzugsreinigung Basel</li>
          <li>Umzugsreinigung Lausanne</li>
          <li>Umzugsreinigung Genf</li>
          <li>Umzugsreinigung Winterthur</li>
          <li>Umzugsreinigung Luzern</li>
        </ul>
      </div>

      <!-- Contact / NAP -->
      <div>
        <h4 class="font-semibold text-white mb-4">Kontakt</h4>
        <div class="space-y-3 text-sm text-slate-400">
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href={phoneHref} class="hover:text-primary-400 transition-colors font-semibold text-white">{phone}</a>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:info@umzugsreinigungprofis.ch" class="hover:text-primary-400 transition-colors">info@umzugsreinigungprofis.ch</a>
          </div>
          <div class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Mo - Sa: 07:00 - 20:00</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-slate-500">&copy; {currentYear} Umzugsreinigung Profis. Alle Rechte vorbehalten.</p>
      <div class="flex gap-4 text-xs text-slate-500">
        <a href="#" class="hover:text-slate-400 transition-colors">Impressum</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Datenschutz</a>
        <a href="#" class="hover:text-slate-400 transition-colors">AGB</a>
      </div>
    </div>
  </div>
</footer>
